{
  "name": "openclaw-personal",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "build:core": "cargo build --release --manifest-path core/Cargo.toml",
    "validate": "openclaw plugins validate --json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2"
  },
  "description": "Personal communication hub for OpenClaw: email and social service launchers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/0132E282/openclaw-personal.git"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "^1.4.7"
  }
}
